@model ProjetoLivraria.Models.CadastroViewModel

@{
    ViewData["Title"] = "Cadastro";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 text-center mb-4">Criar conta - Livraria</h1>

                <form asp-controller="Conta" asp-action="Cadastrar" method="post" asp-antiforgery="true">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" maxlength="150" autocomplete="name" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" maxlength="150" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label"></label>
                        <input asp-for="Senha" class="form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="Senha" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmarSenha" class="form-label"></label>
                        <input asp-for="ConfirmarSenha" class="form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Cadastrar</button>
                </form>

                <p class="text-center mt-3 mb-0">Já tem uma conta? <a asp-controller="Conta" asp-action="Login">Entrar</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
