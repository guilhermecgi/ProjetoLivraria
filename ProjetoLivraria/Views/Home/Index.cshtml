@{
    ViewData["Title"] = "Sistema Livraria";
}

<section class="row justify-content-center py-4 py-md-5" aria-labelledby="titulo-home">
    <div class="col-12 col-lg-9">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <h1 id="titulo-home" class="display-5 fw-bold">Sistema Livraria</h1>
                <p class="lead mt-3">Bem-vindo(a), @ViewBag.NomeUsuario!</p>
                <p class="text-muted mb-0">
                    Gerencie os livros da sua livraria de forma simples e organizada.
                    Cadastre ISBN, nome, descrição e valor para manter seu acervo atualizado.
                </p>
            </div>
        </div>
    </div>
</section>
